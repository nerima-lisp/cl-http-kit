         (check (zerop removed) :mixed-no-default-removal)
         (check (equal partial (counts pathname)) :mixed-native-totals-preserved)
         (compare-projection file (gethash key (car sb-c::*code-coverage-info*)) proof)
         (report (merge-pathnames "boa-mixed-partial/" directory) pathname)
         (check (plusp (auditor-exit root (merge-pathnames "boa-mixed-partial/" directory)))
                :mixed-html-rejects-real-default-gap)))
      (check (eq original (car sb-c::*code-coverage-info*)) :mixed-partial-table-restore)
      (check (equalp before (sb-c::covered-file-executed file)) :mixed-partial-native-bits))
    (let ((object (funcall 'make-boa-mixed-proof 2)))
      (check (= 2 (funcall 'boa-mixed-proof-id object)) :mixed-omitted-id)
      (check (= 4 (funcall 'boa-mixed-proof-optional object)) :mixed-omitted-optional)
      (check (null (funcall 'boa-mixed-proof-value object)) :mixed-omitted-value)
      (check (null (funcall 'boa-mixed-proof-supplied object)) :mixed-omitted-supplied))
    (sb-ext:gc :full t)
    (sb-cover::refresh-coverage-bits)
    (check (= 1 (sbit (sb-c::covered-file-executed file) index))
           :mixed-default-native-bit-transitions)
    (http-coverage-normalization:call-with-projection
     http-coverage-normalization:*proofs*
     (lambda (removed)
       (check (zerop removed) :mixed-complete-no-removal)
       (let ((complete (counts pathname)))
         (check (= (first complete) (second complete)) :mixed-complete-native-expressions))
       (report (merge-pathnames "boa-mixed-complete/" directory) pathname)
       (check (zerop (auditor-exit root (merge-pathnames "boa-mixed-complete/" directory)))
              :mixed-html-native-complete)))
    (check (eq original (car sb-c::*code-coverage-info*)) :mixed-final-table-restore)
    (check (equalp paths (sb-c::covered-file-paths file)) :mixed-native-paths-preserved)))

(defun mixed-function-controls (root directory)
  (group :mixed-function-defaults-remain-native)
  (dolist (spec '(("defun-mixed" mixed-nil-proof nil (4 2 1)
                  (defun mixed-nil-proof (id &optional (optional 4)
                                            &key (value nil supplied))
                    (list id optional value supplied)))
                 ("defun-mixed-integer" mixed-integer-proof 7 (4 2 1)
                  (defun mixed-integer-proof (id &optional (optional 4)
                                                &key (value 7 supplied))
                    (list id optional value supplied)))
                 ("returned-mixed" mixed-lambda-proof nil (4 1 3 1)
                  (defun mixed-lambda-proof ()
                    (lambda (id &optional (optional 4) &key (value nil supplied))
                      (list id optional value supplied))))))
    (destructuring-bind (name function default native-path form) spec
      (let* ((http-coverage-normalization:*proofs* (make-hash-table :test 'equal))
             (pathname (fixture directory name (list form)))
             (proof (compile-fixture pathname))
             (original (car sb-c::*code-coverage-info*))
             (key (namestring (truename pathname)))
             (file (gethash key original))
             (paths (copy-seq (sb-c::covered-file-paths file)))
             (index (position native-path paths :test #'equal))
             (callable (if (string= name "returned-mixed")
                           (funcall function) (symbol-function function))))
        (check (null (http-coverage-normalization:source-proof-candidates proof))
               :mixed-function-no-semantic-exclusion)
        (check index :mixed-function-native-default-path)
        (check (equal (funcall callable 1 9 :value 9) '(1 9 9 t))
               :mixed-function-explicit-result)
        (sb-ext:gc :full t)
        (sb-cover::refresh-coverage-bits)
        (let ((before (copy-seq (sb-c::covered-file-executed file)))
              (partial (counts pathname))
              (report-directory (merge-pathnames (format nil "~A-partial/" name) directory)))
          (check (zerop (sbit before index)) :mixed-function-real-default-unexecuted)
          (check (< (second partial) (first partial)) :mixed-function-native-gap)
          (http-coverage-normalization:call-with-projection
           http-coverage-normalization:*proofs*
           (lambda (removed)
             (check (zerop removed) :mixed-function-no-removal)
             (check (equal partial (counts pathname)) :mixed-function-native-totals)
             (compare-projection file (gethash key (car sb-c::*code-coverage-info*)) proof)
             (report report-directory pathname)
             (check (plusp (auditor-exit root report-directory))
                    :mixed-function-html-rejects-real-default-gap)))
          (check (eq original (car sb-c::*code-coverage-info*)) :mixed-function-partial-table-eq)
          (check (equalp before (sb-c::covered-file-executed file)) :mixed-function-native-bits))
        (check (equal (funcall callable 2) (list 2 4 default nil))
               :mixed-function-omitted-result)
        (sb-ext:gc :full t)
        (sb-cover::refresh-coverage-bits)
        (check (= 1 (sbit (sb-c::covered-file-executed file) index))
               :mixed-function-real-default-bit-transitions)
        (http-coverage-normalization:call-with-projection
         http-coverage-normalization:*proofs*
         (lambda (removed)
           (check (zerop removed) :mixed-function-complete-no-removal)
           (let ((complete (counts pathname)))
             (check (= (first complete) (second complete)) :mixed-function-complete-expressions))
           (let ((report-directory (merge-pathnames (format nil "~A-complete/" name) directory)))
             (report report-directory pathname)
             (check (zerop (auditor-exit root report-directory))
                    :mixed-function-html-native-complete))))
        (check (eq original (car sb-c::*code-coverage-info*)) :mixed-function-final-table-eq)
        (check (equalp paths (sb-c::covered-file-paths file)) :mixed-function-native-paths)))))

(defun reader-fixture (directory name lines)
  (let ((pathname (merge-pathnames (make-pathname :name name :type "lisp") directory)))
    (with-open-file (stream pathname :direction :output :if-exists :error
                           :external-format :utf-8)
      (write-line "(in-package #:http-coverage-normalization-tests)" stream)
      (dolist (line lines) (write-line line stream)))
    (manifest pathname)
    pathname))

(defun reader-controls (root directory)
  (group :atomic-reader-no-evaluation)
  (let* ((before *initializer-calls*)
         (pathname
           (reader-fixture directory "atomic-reader"
                           '("#+(and sbcl (not sbcl)) #.(incf *initializer-calls*)"
                             "(defun reader-key (selector &key (value #.+fixture-seven+))"
                             "  (case selector (#.+reader-case+ value) (otherwise (- value))))"))))
    (multiple-value-bind (candidates dependencies)
        (http-coverage-normalization::source-candidates
         (http-coverage-normalization::source-bytes pathname))
      (check (equal candidates '(((2 2 1) 7 7))) :reader-only-key-candidate)
      (check (equal dependencies '((+fixture-seven+ 7) (+reader-case+ 29)))
             :reader-all-dependencies-including-case))
    (check (= before *initializer-calls*) :suppressed-reader-no-evaluation)
    (dolist (initializer '("(incf *initializer-calls*)" "(+ 3 4)"
                           "*initializer-calls*" "reader-unbound"))
      (let ((unsupported
              (reader-fixture directory (format nil "unsupported-reader-~D" *assertions*)
                              (list (format nil "(defun unsupported-reader (&key (value #.~A)) value)"
                                            initializer)))))
        (rejects (lambda ()
                   (http-coverage-normalization::source-candidates
                    (http-coverage-normalization::source-bytes unsupported)))
                 :unsupported-reader-rejected)
        (when (http-coverage-normalization::normalization-supported-p)
          (check (null (http-coverage-normalization:capture-source unsupported))
                 :unsupported-reader-no-proof))))
    (check (= before *initializer-calls*) :rejected-reader-no-evaluation)
    (when (http-coverage-normalization::normalization-supported-p)
      (group :atomic-reader-native-proof)
      (let* ((http-coverage-normalization:*proofs* (make-hash-table :test 'equal))
             (proof (compile-fixture pathname))
             (original (car sb-c::*code-coverage-info*))
             (resolver-name 'http-coverage-normalization::proven-atomic-value)
             (resolver (fdefinition resolver-name)))
        (check (equal (funcall 'reader-key 29 :value 11) 11) :reader-explicit-true)
        (sb-cover::refresh-coverage-bits)
        (http-coverage-normalization:call-with-projection
         http-coverage-normalization:*proofs*
         (lambda (removed)
           (check (= removed 1) :reader-one-atomic-declaration)
           (report (merge-pathnames "reader-partial/" directory) pathname)
           (check (plusp (auditor-exit root (merge-pathnames "reader-partial/" directory)))
                  :reader-html-real-branch-gap)))
        (check (eq original (car sb-c::*code-coverage-info*)) :reader-partial-restored)
        (unwind-protect
             (progn
               (setf (fdefinition resolver-name)
                     (lambda (initializer)
                       (if (eq initializer '+reader-case+)
                           (values 30 t)
                           (funcall resolver initializer))))
               (rejects (lambda () (http-coverage-normalization::validate-source pathname proof))
                        :reader-case-only-constant-drift))
          (setf (fdefinition resolver-name) resolver))
        (check (eq (fdefinition resolver-name) resolver) :reader-resolver-restored)
        (check (= (funcall 'reader-key 0) -7) :reader-omitted-false)
        (sb-cover::refresh-coverage-bits)
        (http-coverage-normalization:call-with-projection
         http-coverage-normalization:*proofs*
         (lambda (removed)
           (check (= removed 1) :reader-declaration-remains-static)
           (let ((complete (counts pathname)))
             (check (= (first complete) (second complete)) :reader-native-expressions-complete)
             (check (= (third complete) (fourth complete)) :reader-native-branches-complete))
           (report (merge-pathnames "reader-complete/" directory) pathname)
           (check (zerop (auditor-exit root (merge-pathnames "reader-complete/" directory)))
                  :reader-html-complete)))
        (check (eq original (car sb-c::*code-coverage-info*)) :reader-final-restored)))))

(defun portable-controls (root directory)
  (group :portable-semantic-matcher)
  (let* ((forms '((defun portable-atomic (&key (value 7)) (list value))
                  (defun portable-string (&key (value "message")) (list value))
                  (defun portable-supplied (&key (value nil supplied)) (list value supplied))
                  (defun portable-body () 7)
                  (defun portable-lookalike () (let ((value 7)) (list value)))
                  (defun portable-dynamic (&key (value (incf *initializer-calls*))) (list value))
                  (defun portable-foldable (&key (value (+ 3 4))) (list value))
                  (defun portable-optional (&optional (value 7)) (list value))
                  (defun portable-aliased (&key ((:other value) 7)) (list value))
                  (defstruct (portable-boa
                               (:constructor make-portable-boa
                                   (id &key (value 7) (window +fixture-seven+))))
                    id value window)
                  (defstruct (portable-boa-optional
                               (:constructor make-portable-boa-optional
                                   (&optional (value 7))))
                    value)
                  (defstruct (portable-boa-aliased
                               (:constructor make-portable-boa-aliased
                                   (&key ((:other value) 7))))
                    value)
                  (defstruct (portable-boa-compound
                               (:constructor make-portable-boa-compound
                                   (&key (value (+ 3 4)))))
                    value)
                  (defstruct (portable-boa-dynamic
                               (:constructor make-portable-boa-dynamic
                                   (&key (value *initializer-calls*))))
                    value)
                  (defstruct (portable-boa-multiple
                               (:constructor make-portable-boa-one (&key (value 7)))
                               (:constructor make-portable-boa-two (&key (value 8))))
                    value)
                  (defstruct portable-slot-default (value 7))))
         (pathname (fixture directory "portable-semantic" forms))
         (candidates (http-coverage-normalization::source-candidates
                      (http-coverage-normalization::source-bytes pathname))))
    (check (equal (mapcar #'first candidates)
                  '((1 2 1) (1 2 2) (1 2 3) (2 2 1 1 10) (3 2 1 1 10)))
           :portable-only-atomic-key-paths)
    (check (equal (mapcar #'second candidates) '(7 "message" nil 7 +fixture-seven+))
           :portable-initializers)
    (check (equal (mapcar #'third candidates) '(7 "message" nil 7 7))
           :portable-value-snapshots))
  (group :portable-native-html-save)
  (let* ((pathname (fixture directory "portable-native"
                            '((defun portable-branch (value)
                                (if (plusp value) (list :yes value) (list :no value))))))
         (source-hash (sb-md5:md5sum-file pathname))
         (proofs (make-hash-table :test 'equal)))
    ;; Native compilation is real; only the platform policy is made unsupported.
    (sb-sys:without-gcing
      (proclaim '(optimize (sb-cover:store-coverage-data 3)))
      (unwind-protect
           (multiple-value-bind (fasl warnings failure)
               (compile-file pathname :output-file (make-pathname :type "fasl" :defaults pathname)
                             :verbose nil :print nil :external-format :utf-8 :block-compile nil)
             (check (and fasl (not warnings) (not failure)) :portable-clean-compile)
             (load fasl :verbose nil :print nil)
             (retain-coverage-code))
        (proclaim '(optimize (sb-cover:store-coverage-data 0)))))
    (check (equal (funcall 'portable-branch 1) '(:yes 1)) :portable-true-value)
    (sb-ext:gc :full t)
    (sb-cover::refresh-coverage-bits)
    (let* ((raw (car sb-c::*code-coverage-info*))
           (key (namestring (truename pathname)))
           (record (gethash key raw))
           (paths (copy-tree (coerce (sb-c::covered-file-paths record) 'list)))
           (bits (copy-seq (sb-c::covered-file-executed record)))
           (partial (counts pathname))
           (platform-function (symbol-function 'http-coverage-normalization::normalization-supported-p)))
      (check (plusp (first partial)) :portable-nonempty-expressions)
      (check (plusp (third partial)) :portable-nonempty-branches)
      (check (< (second partial) (first partial)) :portable-genuine-body-gap)
      (check (< (fourth partial) (third partial)) :portable-genuine-branch-gap)
      (with-unsupported-platform
       (lambda ()
         (check (null (http-coverage-normalization:capture-source pathname)) :portable-no-proof)
         (http-coverage-normalization:call-with-deferred-projection
          proofs
          (lambda (install)
            (check (zerop (funcall install)) :portable-zero-removal)
            (check (eq raw (car sb-c::*code-coverage-info*)) :portable-raw-table)
            (check (equal partial (counts pathname)) :portable-raw-totals)
            (check (equal paths (coerce (sb-c::covered-file-paths record) 'list)) :portable-raw-paths)
            (check (equalp bits (sb-c::covered-file-executed record)) :portable-raw-bits)
            (report (merge-pathnames "portable-partial/" directory) pathname)
            (check (plusp (auditor-exit root (merge-pathnames "portable-partial/" directory)))
                   :portable-html-rejects-genuine-gap)))
         (check (eq raw (car sb-c::*code-coverage-info*)) :portable-partial-restore)
         (check (equal (funcall 'portable-branch -1) '(:no -1)) :portable-false-value)
         (sb-cover::refresh-coverage-bits)
         (let* ((complete (counts pathname))
                (before-save (sb-cover:save-coverage)))
           (check (= (first complete) (second complete)) :portable-complete-expressions)
           (check (= (third complete) (fourth complete)) :portable-complete-branches)
           (http-coverage-normalization:call-with-deferred-projection
            proofs
            (lambda (install)
              (check (zerop (funcall install)) :portable-complete-zero-removal)
              (check (equal complete (counts pathname)) :portable-complete-raw-totals)
              (report (merge-pathnames "portable-complete/" directory) pathname)
              (check (zerop (auditor-exit root (merge-pathnames "portable-complete/" directory)))
                     :portable-html-complete)
              (let* ((saved (sb-cover:save-coverage))
                     (entry (assoc key saved :test #'equal))
                     (saved-pathname (merge-pathnames "portable.coverage" directory)))
                (check entry :portable-save-nonempty)
                (check (equalp saved before-save) :portable-save-raw-unchanged)
                (check (equalp (second entry) (sb-c::covered-file-paths record)) :portable-save-paths)
                (check (equalp (cddr entry) (sb-c::covered-file-executed record)) :portable-save-bits)
                (sb-cover:save-coverage-in-file saved-pathname)
                (with-open-file (stream saved-pathname)
                  (with-standard-io-syntax
                    (let ((*read-eval* nil))
                      (check (equalp (read stream) saved) :portable-save-bytes)
                      (check (eq :eof (read stream nil :eof)) :portable-save-eof))))
                (manifest saved-pathname))))
           (format t "COUNTS portable raw-partial=~S raw-complete=~S removed=0~%" partial complete))
         (rejects (lambda ()
                    (http-coverage-normalization:call-with-deferred-projection
                     proofs (lambda (install) (funcall install) (error "Portable consumer failed."))))
                  :portable-error-propagates)
         (check (eq raw (car sb-c::*code-coverage-info*)) :portable-error-restore)))
      (check (eq platform-function
                 (symbol-function 'http-coverage-normalization::normalization-supported-p))
             :portable-platform-restored)
      (check (eq raw (car sb-c::*code-coverage-info*)) :portable-final-restore))
    (check (equalp source-hash (sb-md5:md5sum-file pathname)) :portable-source-unchanged)))

(defun callback-fixture-form (name lambda-list)
  (let ((deadline (find-symbol "WITH-HTTP-DEADLINE" "HTTP-KIT"))
        (translation (find-symbol "%WITH-HTTP-ERROR-TRANSLATION" "HTTP-KIT"))
        (clock (find-symbol "%MONOTONIC-TIME" "HTTP-KIT")))
    `(defun ,name (on-stream-open)
       (let* ((seed 1))
         (,deadline (absolute-deadline nil :clock-function (function ,clock))
           (,translation ("Callback fixture failed." :fixture)
             (handler-case
                 (let* ((stream-id seed))
                   (multiple-value-bind (value) (values stream-id)
                     (when on-stream-open
                       (funcall on-stream-open value
                                (lambda ,lambda-list (list error-code))))))
               (error (condition) (error condition)))))))))

(defun callback-key-controls (root directory)
  (let* ((dependencies (mapcar (lambda (name) (merge-pathnames name root))
                              '("src/package.lisp" "src/conditions.lisp"
                                "src/utilities.lisp" "src/control-macros.lisp")))
         (hashes (mapcar #'sb-md5:md5sum-file dependencies)))
    ;; The callback fixture needs the package, not its message-kit imports.
    (unless (find-package "HTTP-KIT")
      (make-package "HTTP-KIT" :use (list "COMMON-LISP")))
    (dolist (pathname (rest dependencies))
      (load pathname :verbose nil :print nil))
    (group :callback-finite-source-grammar)
    (let* ((base (callback-fixture-form 'callback-atomic '(&key (error-code 8))))
           (foreign (or (find-package "HTTP-COVERAGE-FOREIGN-CONTROL")
                        (make-package "HTTP-COVERAGE-FOREIGN-CONTROL" :use nil)))
           (forms
             (append
              (list base)
              (loop for keys in '((&key (error-code (progn (incf *initializer-calls*) 8)))
                                 (&optional extra &key (error-code 8))
                                 (&rest args &key (error-code 8))
                                 (&key (error-code 7))
                                 (&key (error-code 8 supplied)))
                    for index from 0
                    collect (callback-fixture-form (intern (format nil "CALLBACK-NEGATIVE-~D" index)) keys))
              (loop for wrapper in '(quote function callback-unknown)
                    collect `(defun ,(gensym "WRAPPED") (on-stream-open)
                               (,wrapper ,(fourth base))))
              (list (let ((copy (copy-tree base)))
                      (setf (first (fourth copy)) (intern "LET*" foreign)) copy)
                    '(defun callback-direct ()
                       (funcall (lambda (&key (error-code 8)) (list error-code)))))))
           (pathname (fixture directory "callback-grammar-controls" forms))
           (before *initializer-calls*)
           (candidates (http-coverage-normalization::source-candidates
                        (http-coverage-normalization::source-bytes pathname))))
      (check (equal candidates '(((1 1 3 2 3 2 1 2 2 2 3 1) 8 8)))
             :only-finite-pure-single-numeric-eight)
      (check (= before *initializer-calls*) :grammar-never-evaluates-default)
      (format t "CALLBACK-GRAMMAR forms=~D candidates=~S~%" (length forms) candidates))
    (group :callback-native-map-and-real-gaps)
    (let* ((http-coverage-normalization:*proofs* (make-hash-table :test 'equal))
           (pathname
             (fixture directory "callback-native-controls"
                      (list (callback-fixture-form 'callback-atomic '(&key (error-code 8)))
                            (callback-fixture-form
                             'callback-dynamic
                             '(&key (error-code (progn (incf *initializer-calls*) 8))))
                            '(defun callback-real-branch (value)
                               (if (plusp value) (list :positive value) (list :negative value))))))
           (proof (compile-fixture pathname))
           (key (namestring (truename pathname)))
           (raw (car sb-c::*code-coverage-info*))
           (file (gethash key raw))
           (paths (sb-c::covered-file-paths file))
           (expected '(1 1 3 2 3 2 1 2 2 2 3 1))
           (dynamic '(1 1 1 3 2 3 2 1 2 2 2 3 2))
           (maps (loop for code in *code-roots*
                       when (equal key (sb-c::debug-source-namestring
                                        (sb-c::debug-info-source (sb-kernel:%code-debug-info code))))
                         collect (sb-cover::%find-coverage-map code)))
           (functions (mapcar #'symbol-function '(callback-atomic callback-dynamic)))
           (macros (mapcar (lambda (name) (find-symbol name "HTTP-KIT"))
                          '("WITH-HTTP-DEADLINE" "%WITH-HTTP-ERROR-TRANSLATION")))
           (macro-functions (mapcar #'macro-function macros)))
      (check (equal (http-coverage-normalization:source-proof-candidates proof)
                    (list (list expected 8 8))) :callback-only-atomic-candidate)
      (check maps :callback-nonempty-native-code-maps)
      (check (= 1 (count expected paths :test #'equal)) :callback-unique-native-path)
      (check (= 1 (count dynamic paths :test #'equal)) :callback-unique-dynamic-path)
      (labels ((mapped-p (path)
                 (some (lambda (map)
                         (find path map :test (lambda (wanted group)
                                               (member wanted group :test #'equal)))) maps))
               (execution-bit (path)
                 (sbit (sb-c::covered-file-executed file) (position path paths :test #'equal)))
               (snapshot (stage dynamic-bit)
                 (sb-ext:gc :full t)
                 (sb-cover::refresh-coverage-bits)
                 (check (zerop (execution-bit expected)) :callback-atomic-zero)
                 (check (not (mapped-p expected)) :callback-no-native-marker)
                 (check (mapped-p dynamic) :callback-dynamic-native-marker)
                 (check (= dynamic-bit (execution-bit dynamic)) :callback-dynamic-execution-bit)
                 (format t "CALLBACK-NATIVE stage=~S atomic-path=~S bit=0 marker=absent dynamic-path=~S bit=~D marker=present~%"
                         stage expected dynamic dynamic-bit))
               (gap (name)
                 (sb-cover::refresh-coverage-bits)
                 (let ((bits (copy-seq (sb-c::covered-file-executed file)))
                       (raw-paths (map 'vector #'copy-tree paths))
                       (before (counts pathname))
                       (output (merge-pathnames name directory)))
                   (http-coverage-normalization:call-with-projection
                    http-coverage-normalization:*proofs*
                    (lambda (removed)
                      (check (= removed 1) :callback-exactly-one-ghost)
                      (compare-projection file (gethash key (car sb-c::*code-coverage-info*)) proof)
                      (check (equal (counts pathname) (cons (1- (first before)) (rest before)))
                             :callback-only-expression-total-changes)
                      (check (< (fourth (counts pathname)) (third (counts pathname)))
                             :callback-real-branch-gap-retained)
                      (report output pathname)
                      (check (plusp (auditor-exit root output)) :callback-html-rejects-real-gap)
                      (format t "CALLBACK-COUNTS raw=~S projected=~S removed=~D~%" before (counts pathname) removed)))
                   (check (eq raw (car sb-c::*code-coverage-info*)) :callback-table-eq-restored)
                   (check (equalp raw-paths (sb-c::covered-file-paths file)) :callback-raw-paths-unchanged)
                   (check (equalp bits (sb-c::covered-file-executed file)) :callback-raw-bits-unchanged))))
        (setf *initializer-calls* 0)
        (snapshot :unused 0)
        (check (null (funcall (first functions) nil)) :callback-when-not-executed)
        (snapshot :when-not-executed 0)
        (check (equal '(:positive 1) (callback-real-branch 1)) :callback-real-branch-control)
        (gap "callback-when-gap/")
        (let ((atomic nil) (dynamic-closure nil) (opens 0))
          (funcall (first functions) (lambda (id callback)
                                      (check (= id 1) :callback-stream-id)
                                      (incf opens) (setf atomic callback)))
          (funcall (second functions) (lambda (id callback)
                                       (check (= id 1) :dynamic-stream-id)
                                       (incf opens) (setf dynamic-closure callback)))
          (check (= opens 2) :callback-open-count)
          (check (and (functionp atomic) (functionp dynamic-closure)) :callback-functions)
          (check (equal '(8) (funcall atomic :error-code 8)) :callback-explicit-eight)
          (check (equal '(0) (funcall atomic :error-code 0)) :callback-explicit-zero)
          (check (equal '(8) (funcall dynamic-closure :error-code 8)) :callback-dynamic-explicit)
          (check (zerop *initializer-calls*) :callback-explicit-no-default-side-effect)
          (snapshot :explicit 0)
          (check (equal '(8) (funcall atomic)) :callback-omitted-eight)
          (check (equal '(8) (funcall dynamic-closure)) :callback-dynamic-default)
          (check (= 1 *initializer-calls*) :callback-dynamic-default-once)
          (snapshot :omitted 1))
        (gap "callback-omitted-gap/"))
      (group :callback-proof-dependencies-fail-closed)
      (let ((candidates (http-coverage-normalization:source-proof-candidates proof))
            (native-paths (http-coverage-normalization:source-proof-paths proof))
            (features (http-coverage-normalization::source-proof-features proof))
            (bytes (http-coverage-normalization:source-proof-bytes proof)))
        (flet ((reject-projection (label)
                 (rejects (lambda () (http-coverage-normalization:project-table
                                     raw http-coverage-normalization:*proofs*)) label)
                 (check (eq raw (car sb-c::*code-coverage-info*)) :callback-rejection-table-eq)))
          (unwind-protect
               (progn
                 (setf (http-coverage-normalization:source-proof-candidates proof)
                       (list (list '(0 1 3 2 3 2 1 2 2 2 3 1) 8 8)))
                 (reject-projection :callback-source-path-tamper)
                 (setf (http-coverage-normalization:source-proof-candidates proof) candidates
                       (http-coverage-normalization:source-proof-paths proof) #())
                 (reject-projection :callback-native-path-drift)
                 (setf (http-coverage-normalization:source-proof-paths proof) native-paths
                       (http-coverage-normalization::source-proof-features proof) nil)
                 (reject-projection :callback-feature-drift)
                 (setf (http-coverage-normalization::source-proof-features proof) features
                       (http-coverage-normalization:source-proof-bytes proof) #())
                 (reject-projection :callback-byte-drift))
            (setf (http-coverage-normalization:source-proof-candidates proof) candidates
                  (http-coverage-normalization:source-proof-paths proof) native-paths
                  (http-coverage-normalization::source-proof-features proof) features
                  (http-coverage-normalization:source-proof-bytes proof) bytes))
          (loop for symbol in macros for original in macro-functions
                do (unwind-protect
                       (progn
                         (setf (macro-function symbol)
                               (lambda (form environment)
                                 (declare (ignore form environment)) nil))
                         (reject-projection :callback-macro-function-drift))
                     (setf (macro-function symbol) original))
                   (check (eq original (macro-function symbol)) :callback-macro-spy-eq-restored))
          (let* ((copy (merge-pathnames "callback-macro-byte-control.lisp" directory))
                 (macro-bytes (http-coverage-normalization::source-bytes
                               http-coverage-normalization::*callback-macro-source*)))
            (with-open-file (stream copy :direction :output :if-exists :error
                                        :element-type '(unsigned-byte 8))
              (write-sequence macro-bytes stream)
              (write-byte 10 stream))
            (let ((http-coverage-normalization::*callback-macro-source* copy))
              (reject-projection :callback-macro-source-bytes-drift)))))
      (loop for symbol in '(callback-atomic callback-dynamic) for original in functions
            do (check (eq original (symbol-function symbol)) :callback-function-eq-unchanged))
      (loop for symbol in macros for original in macro-functions
            do (check (eq original (macro-function symbol)) :callback-final-macro-eq))
      (check (eq raw (car sb-c::*code-coverage-info*)) :callback-final-table-eq)
      (format t "CALLBACK-RESTORATION functions=2 macros=2 table=EQ~%"))
    (loop for pathname in dependencies for before in hashes
          do (check (equalp before (sb-md5:md5sum-file pathname)) :callback-dependency-source-unchanged)
             (manifest pathname))))

(defun h3-placement-form (name keys)
  `(defun ,name (on-stream-open)
     (let* ((stream :stream) (stream-id 1))
       (unwind-protect
            (handler-case
                (progn
                  (when on-stream-open
                    (funcall on-stream-open stream stream-id
                             (lambda ,keys (list error-code)))))
              (error (condition) (error condition)))
         (values)))))

(defun placement-key-controls (root directory)
  (group :placement-finite-source-grammar)
  (let* ((base (h3-placement-form 'placement-callback '(&key (error-code 268))))
         (foreign (find-package "HTTP-COVERAGE-FOREIGN-CONTROL"))
         (forms
           (append
            (list '(progn (defun placement-listener
                              (&key (port 0) (backlog 128) (reuse-address t) (session-options nil))
                            (list port backlog reuse-address session-options)))
                  '(defun placement-alpn (&key (alpn '("h3"))) alpn)
                  base)
            (loop for wrapper in '(progn placement-unknown quote function)
                  collect `(,wrapper (progn (defun ,(gensym "NESTED") (&key (value 268)) value))))
            (list `(,(intern "PROGN" foreign) (defun placement-foreign (&key (value 268)) value))
                  `(progn (,(intern "DEFUN" foreign) placement-foreign (&key (value 268)) value)))
            (loop for keys in '((&key (error-code (progn (incf *initializer-calls*) 268)))
                               (&optional extra &key (error-code 268))
                               (&rest args &key (error-code 268))
                               (&key (error-code 267)) (&key (error-code 268 supplied)))
                  collect (h3-placement-form (gensym "H3-NEGATIVE") keys))
            (loop for wrapper in '(quote function placement-unknown)
                  collect `(defun ,(gensym "H3-WRAPPED") (on-stream-open) (,wrapper ,(fourth base))))
            (list (let ((copy (copy-tree base)))
                    (setf (first (fourth copy)) (intern "LET*" foreign)) copy)
                  '(defun placement-other-list (&key (alpn '("h2"))) alpn)
                  '(defun placement-other-name (&key (other '("h3"))) other)
                  '(defun placement-supplied-list (&key (alpn '("h3") supplied)) (list alpn supplied))
                  '(defun placement-mixed-list (&optional x &key (alpn '("h3"))) (list x alpn)))))
         (pathname (fixture directory "placement-grammar" forms))
         (before *initializer-calls*)
         (candidates (http-coverage-normalization::source-candidates
                      (http-coverage-normalization::source-bytes pathname))))
    (check (equal candidates
                  '(((1 2 1 1) 0 0) ((2 2 1 1) 128 128) ((3 2 1 1) t t)
                    ((4 2 1 1) nil nil) ((1 1 2 2) (quote ("h3")) ("h3"))
                    ((1 1 4 2 1 1 1 2 3 3) 268 268)))
           :placement-only-approved-grammar)
    (check (= before *initializer-calls*) :placement-no-default-evaluation)
    (format t "PLACEMENT-GRAMMAR forms=~D candidates=~S~%" (length forms) candidates))
  (group :placement-native-markers-and-real-gaps)
  (let* ((http-coverage-normalization:*proofs* (make-hash-table :test 'equal))
         (pathname
           (fixture directory "placement-native"
                    (list '(progn (defun placement-listener
                                      (&key (port 0) (backlog 128) (reuse-address t) (session-options nil))
                                    (list port backlog reuse-address session-options)))
                          '(defun placement-alpn (&key (alpn '("h3"))) alpn)
                          (h3-placement-form 'placement-callback '(&key (error-code 268)))
                          '(defun placement-dynamic
                               (&key (value (progn (incf *initializer-calls*) 268))) value)
                          '(defun placement-mixed (&optional x &key (value 268)) (list x value))
                          '(defun placement-branch (value)
                             (if (plusp value) (list :positive value) (list :negative value))))))
         (proof (compile-fixture pathname))
         (key (namestring (truename pathname)))
         (raw (car sb-c::*code-coverage-info*))
         (file (gethash key raw))
         (paths (sb-c::covered-file-paths file))
         (expected '((1 2 1 1) (2 2 1 1) (3 2 1 1) (4 2 1 1)
                     (1 1 2 2) (1 1 4 2 1 1 1 2 3 3)))
         (emitted '((1 1 2 4) (3 2 5)))
         (symbols '(placement-listener placement-alpn placement-callback
                    placement-dynamic placement-mixed placement-branch))
         (functions (mapcar #'symbol-function symbols))
         (maps (loop for code in *code-roots*
                     when (equal key (sb-c::debug-source-namestring
                                      (sb-c::debug-info-source (sb-kernel:%code-debug-info code))))
                       collect (sb-cover::%find-coverage-map code))))
    (check (equal expected (mapcar #'first (http-coverage-normalization:source-proof-candidates proof)))
           :placement-exact-six-native-candidates)
    (check maps :placement-nonempty-native-maps)
    (labels ((marker (path)
               (some (lambda (map) (find path map :test (lambda (wanted group)
                                                        (member wanted group :test #'equal)))) maps))
             (snapshot (stage emitted-bit)
               (sb-ext:gc :full t)
               (sb-cover::refresh-coverage-bits)
               (loop for path in (append expected emitted)
                     for index = (position path paths :test #'equal)
                     do (check (= 1 (count path paths :test #'equal)) :placement-unique-native-path)
                        (check (= (if (member path expected :test #'equal) 0 emitted-bit)
                                  (sbit (sb-c::covered-file-executed file) index)) :placement-native-bit)
                        (check (eq (not (null (marker path)))
                                   (not (null (member path emitted :test #'equal)))) :placement-native-marker)
                        (format t "PLACEMENT-NATIVE stage=~S path=~S bit=~D marker=~S~%"
                                stage path (sbit (sb-c::covered-file-executed file) index)
                                (not (null (marker path))))))
             (gap (name)
               (let ((before (counts pathname))
                     (bits (copy-seq (sb-c::covered-file-executed file)))
                     (saved-paths (map 'vector #'copy-tree paths)))
                 (http-coverage-normalization:call-with-projection
                  http-coverage-normalization:*proofs*
                  (lambda (removed)
                    (check (= removed 6) :placement-only-six-declarations)
                    (compare-projection file (gethash key (car sb-c::*code-coverage-info*)) proof)
                    (check (equal (counts pathname) (cons (- (first before) 6) (rest before)))
                           :placement-only-expression-total-delta)
                    (check (< (fourth (counts pathname)) (third (counts pathname)))
                           :placement-executable-branch-stays-uncovered)
                    (report (merge-pathnames name directory) pathname)
                    (check (plusp (auditor-exit root (merge-pathnames name directory)))
                           :placement-html-rejects-real-gap)
                    (format t "PLACEMENT-COUNTS raw=~S projected=~S removed=~D~%"
                            before (counts pathname) removed)))
                 (check (eq raw (car sb-c::*code-coverage-info*)) :placement-table-eq-restored)
                 (check (equalp bits (sb-c::covered-file-executed file)) :placement-raw-bits-unchanged)
                 (check (equalp saved-paths (sb-c::covered-file-paths file)) :placement-raw-paths-unchanged))))
      (setf *initializer-calls* 0)
      (snapshot :unused 0)
      (check (null (placement-callback nil)) :placement-when-unexecuted)
      (check (equal '(:positive 1) (placement-branch 1)) :placement-genuine-branch-control)
      (snapshot :when-unexecuted 0)
      (gap "placement-when-gap/")
      (check (equal '(0 128 t nil) (placement-listener)) :placement-listener-omitted)
      (check (equal '(0 128 t nil)
                    (placement-listener :port 0 :backlog 128 :reuse-address t :session-options nil))
             :placement-listener-explicit)
      (check (equal '("h3") (placement-alpn)) :placement-alpn-omitted)
      (check (equal '("h3") (placement-alpn :alpn '("h3"))) :placement-alpn-explicit)
      (let ((closure nil) (opens 0))
        (placement-callback (lambda (stream id callback)
                              (check (eq stream :stream) :placement-stream-identity)
                              (check (= id 1) :placement-stream-id)
                              (incf opens) (setf closure callback)))
        (check (= opens 1) :placement-open-once)
        (check (functionp closure) :placement-closure)
        (check (equal '(268) (funcall closure :error-code 268)) :placement-explicit-default)
        (check (equal '(0) (funcall closure :error-code 0)) :placement-explicit-zero)
        (check (equal '(nil) (funcall closure :error-code nil)) :placement-explicit-nil)
        (check (equal '(268) (funcall closure)) :placement-omitted-default))
      (check (= 268 (placement-dynamic :value 268)) :placement-dynamic-explicit)
      (check (equal '(nil 268) (placement-mixed nil :value 268)) :placement-mixed-explicit)
      (check (zerop *initializer-calls*) :placement-no-explicit-side-effect)
      (snapshot :explicit 0)
      (check (= 268 (placement-dynamic)) :placement-dynamic-omitted)
      (check (= 1 *initializer-calls*) :placement-dynamic-side-effect-once)
      (check (equal '(nil 268) (placement-mixed)) :placement-mixed-omitted)
      (snapshot :omitted 1)
      (gap "placement-omitted-gap/"))
    (group :placement-proof-fail-closed)
    (let ((candidates (http-coverage-normalization:source-proof-candidates proof))
          (native-paths (http-coverage-normalization:source-proof-paths proof))
          (features (http-coverage-normalization::source-proof-features proof))
          (bytes (http-coverage-normalization:source-proof-bytes proof)))
      (unwind-protect
           (progn
             (setf (http-coverage-normalization:source-proof-candidates proof)
                   (cons (list '(0 1 4 2 1 1 1 2 3 3) 268 268) (rest candidates)))
             (rejects (lambda () (http-coverage-normalization:project-table
                                 raw http-coverage-normalization:*proofs*)) :placement-path-tamper)
             (setf (http-coverage-normalization:source-proof-candidates proof) candidates
                   (http-coverage-normalization:source-proof-paths proof) #())
             (rejects (lambda () (http-coverage-normalization:project-table
                                 raw http-coverage-normalization:*proofs*)) :placement-native-drift)
             (setf (http-coverage-normalization:source-proof-paths proof) native-paths
                   (http-coverage-normalization::source-proof-features proof) nil)
             (rejects (lambda () (http-coverage-normalization:project-table
                                 raw http-coverage-normalization:*proofs*)) :placement-feature-drift)
             (setf (http-coverage-normalization::source-proof-features proof) features
                   (http-coverage-normalization:source-proof-bytes proof) #())
             (rejects (lambda () (http-coverage-normalization:project-table
                                 raw http-coverage-normalization:*proofs*)) :placement-byte-drift))
        (setf (http-coverage-normalization:source-proof-candidates proof) candidates
              (http-coverage-normalization:source-proof-paths proof) native-paths
              (http-coverage-normalization::source-proof-features proof) features
              (http-coverage-normalization:source-proof-bytes proof) bytes)))
    (loop for symbol in symbols for original in functions
          do (check (eq original (symbol-function symbol)) :placement-function-eq-unchanged))
    (check (eq raw (car sb-c::*code-coverage-info*)) :placement-final-table-eq)
    (format t "PLACEMENT-RESTORATION functions=6 spies=none table=EQ~%")))

(let* ((root (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
       (arguments (uiop:command-line-arguments))
       (identity-only (equal (rest arguments) '("--identity-only")))
       (ci-mode (equal (rest arguments) '("--ci")))
       (directory (and (or (= (length arguments) 1) identity-only ci-mode)
                       (uiop:ensure-directory-pathname (first arguments))))
       (sources (list *load-truename* (merge-pathnames "scripts/coverage-normalization.lisp" root)
                      (merge-pathnames "scripts/check-coverage.pl" root)))
       (hashes (mapcar #'sb-md5:md5sum-file sources)))
  (unless (and directory (probe-file directory))
    (error "Pass one existing unique scratch directory, optionally followed by --identity-only or --ci."))
  (setf directory (truename directory))
  (format t "PLATFORM ~A ~A ~A~%" (lisp-implementation-version) (machine-type) (software-type))
  (dolist (pathname sources)
    (manifest pathname))
  (sb-cover:clear-coverage)
  (identity-controls)
  (unless identity-only (reader-controls root directory))
  (when ci-mode
    (format t "CI native-projection=~S unsupported-policy=raw~%"
            (http-coverage-normalization::normalization-supported-p))
    (portable-controls root directory))
  (unless (or identity-only (and ci-mode (not (http-coverage-normalization::normalization-supported-p))))
  (literal-and-supplied-controls root directory)
  (float-and-returned-lambda-controls root directory)
  (keyword-nil-controls root directory)
  (quoted-nil-key-controls root directory)
  (boa-controls root directory)
  (boa-mixed-controls root directory)
  (mixed-function-controls root directory)
  (setf *initializer-calls* 0)
  (let* ((http-coverage-normalization:*proofs* (make-hash-table :test 'equal))
         (forms '((defvar *initializer-calls* 0)
                  (defun dynamic-value () (incf *initializer-calls*) 7)
                  (defun literal-key (&key (value 7)) (list :literal value))
                  (defun named-key (&key (value +fixture-seven+)) (list :named value))
                  (defun boolean-key (&key (value t)) (list :boolean value))
                  (defun nil-key (&key (value nil)) (list :nil value))
                  (defun keyword-key (&key (value :ok)) (list :keyword value))
                  (defun uncalled-key (&key (value 7)) (list :uncalled value))
                  (defun ordinary-literal () 7)
                  (defun lookalike-body () (let ((value 7)) (list :body value)))
                  (defun dynamic-key (&key (value (dynamic-value))) (list :dynamic value))
                  (defun foldable-key (&key (value (+ 3 4))) (list :foldable value))
                  (defun optional-key (&optional (value 7)) (list :optional value))
                  (defun supplied-key (&key (value 7 supplied)) (list :supplied value supplied))
                  (defun aliased-key (&key ((:other value) 7)) (list :aliased value))
                  (defun nested-key () (funcall (lambda (&key (value 7)) (list :nested value))))
                  (defun uncalled-nested-key () (funcall (lambda (&key (value 7)) (list :nested value))))
                  (defun branching-control (value)
                    (if (plusp value) (list :positive value) (list :negative value)))))
         (pathname (fixture directory "controls" forms))
         (proof (compile-fixture pathname))
         (key (namestring (truename pathname)))
         (original (car sb-c::*code-coverage-info*)))
    (group :unsupported-platform-keeps-raw)
    (dolist (platform '(("2.6.6" "ARM64" "Darwin") ("2.6.6" "X86-64" "Linux")))
      (check (apply #'http-coverage-normalization::normalization-supported-p platform)
             :proven-platform))
    (dolist (platform '(("2.6.6" "ARM64" "Linux") ("2.6.6" "X86-64" "Darwin")
                        ("2.6.0" "ARM64" "Darwin") ("2.6.0" "X86-64" "Linux")))
      (check (not (apply #'http-coverage-normalization::normalization-supported-p platform))
             :unproved-platform))
    (with-unsupported-platform
     (lambda ()
       (check (null (http-coverage-normalization:capture-source "nonexistent-source"))
              :no-unproved-source-read)
       (sb-cover::refresh-coverage-bits)
       (let ((before (counts pathname)))
         (http-coverage-normalization:call-with-deferred-projection
          http-coverage-normalization:*proofs*
          (lambda (install)
            (check (zerop (funcall install)) :no-unproved-removal)
            (check (zerop (funcall install)) :raw-idempotent)
            (check (eq original (car sb-c::*code-coverage-info*)) :raw-table-identity)
            (check (equal before (counts pathname)) :raw-native-counts)
            (report (merge-pathnames "unsupported/" directory) pathname)
            (check (not (zerop (auditor-exit root (merge-pathnames "unsupported/" directory))))
                   :raw-html-gate-not-weakened)
            (format t "COUNTS unsupported raw=~S projected=~S removed=0~%" before (counts pathname))))
         (rejects (lambda () (http-coverage-normalization:call-with-projection
                             http-coverage-normalization:*proofs*
                             (lambda (removed) (check (zerop removed) :raw-error-zero)
                               (error "Raw report failed.")))) :raw-report-error)
         (check (eq original (car sb-c::*code-coverage-info*)) :raw-error-restore))))
    (check (http-coverage-normalization::normalization-supported-p) :platform-function-restored)
    (group :semantic-matcher)
    (check (= (length (http-coverage-normalization:source-proof-candidates proof)) 7) :seven-atomic-keys)
    (check (equal (mapcar (lambda (candidate)
                           (second (nth (1- (third (first candidate))) forms)))
                         (http-coverage-normalization:source-proof-candidates proof))
                  '(literal-key named-key boolean-key nil-key keyword-key uncalled-key supplied-key))
           :uncalled-nested-lambda-not-proven)
    (check (equal (literal-key :value 19) '(:literal 19)) :explicit-key)
    (check (equal (dynamic-key :value 19) '(:dynamic 19)) :explicit-dynamic)
    (check (zerop *initializer-calls*) :not-evaluated)
    (check (equal (branching-control 1) '(:positive 1)) :positive-branch)
    (group :projection-and-genuine-gaps)
    (sb-cover::refresh-coverage-bits)
    (let ((before (counts pathname)))
      (http-coverage-normalization:call-with-projection
       http-coverage-normalization:*proofs*
       (lambda (removed)
         (check (= removed 7) :exact-removal)
         (compare-projection (gethash key original) (gethash key (car sb-c::*code-coverage-info*)) proof)
         (let ((after (counts pathname)))
           (check (equal after (cons (- (first before) 7) (rest before))) :total-only)
           (check (< (second after) (first after)) :genuine-bodies-remain)
           (format t "COUNTS explicit raw=~S projected=~S removed=~D~%" before after removed))
         (report (merge-pathnames "negative/" directory) pathname)
         (check (not (zerop (auditor-exit root (merge-pathnames "negative/" directory))))
                :html-rejects-genuine-gaps))))
    (check (eq original (car sb-c::*code-coverage-info*)) :restore-success)
    (group :runtime-defaults)
    (dolist (pair '((literal-key :literal 7) (named-key :named 7) (boolean-key :boolean t)
                    (nil-key :nil nil) (keyword-key :keyword :ok) (dynamic-key :dynamic 7)
                    (foldable-key :foldable 7) (optional-key :optional 7)
                    (supplied-key :supplied 7 nil) (aliased-key :aliased 7) (nested-key :nested 7)))
      (check (equal (funcall (first pair)) (rest pair)) (first pair)))
    (check (= *initializer-calls* 1) :evaluated-once)
    (check (equal (branching-control -1) '(:negative -1)) :negative-branch)
    (http-coverage-normalization:call-with-projection
     http-coverage-normalization:*proofs*
     (lambda (removed)
       (check (= removed 7) :same-static-declarations)
       (compare-projection (gethash key original) (gethash key (car sb-c::*code-coverage-info*)) proof)
       (format t "COUNTS omitted projected=~S removed=~D~%" (counts pathname) removed)
       (check (= (third (counts pathname)) (fourth (counts pathname))) :branches-genuinely-covered)))
    (group :proof-and-source-fail-closed)
    (let ((candidates (http-coverage-normalization:source-proof-candidates proof))
          (paths (http-coverage-normalization:source-proof-paths proof))
          (bytes (http-coverage-normalization:source-proof-bytes proof))
          (features (http-coverage-normalization::source-proof-features proof)))
      (unwind-protect
           (progn
             (setf (http-coverage-normalization:source-proof-candidates proof)
                   (cons '((0 3 0) 7 7) candidates))
             (rejects (lambda () (http-coverage-normalization:call-with-projection
                                 http-coverage-normalization:*proofs* #'identity)) :body-proof-tamper)
             (setf (http-coverage-normalization:source-proof-candidates proof) candidates
                   (http-coverage-normalization:source-proof-paths proof) #())
             (rejects (lambda () (http-coverage-normalization:project-table original
                                 http-coverage-normalization:*proofs*)) :native-path-drift)
             (setf (http-coverage-normalization:source-proof-paths proof) paths
                   (http-coverage-normalization::source-proof-features proof) nil)
             (rejects (lambda () (http-coverage-normalization:project-table original
                                 http-coverage-normalization:*proofs*)) :features-drift)
             (setf (http-coverage-normalization::source-proof-features proof) features
                   (http-coverage-normalization:source-proof-bytes proof) #())
             (rejects (lambda () (http-coverage-normalization:project-table original
                                 http-coverage-normalization:*proofs*)) :bytes-drift)
             (check (eq original (car sb-c::*code-coverage-info*)) :fail-closed-original))
        (setf (http-coverage-normalization:source-proof-candidates proof) candidates
              (http-coverage-normalization:source-proof-paths proof) paths
              (http-coverage-normalization:source-proof-bytes proof) bytes
              (http-coverage-normalization::source-proof-features proof) features)))
    (let ((missing (make-hash-table :test 'equal)))
      (setf (gethash "missing-source" missing) proof)
      (rejects (lambda () (http-coverage-normalization:project-table original missing)) :missing-source))
    (group :restore-and-bit-one)
    (rejects (lambda () (http-coverage-normalization:call-with-projection
                        http-coverage-normalization:*proofs*
                        (lambda (removed) (declare (ignore removed)) (error "Report failed."))))
             :callback-error)
    (check (eq original (car sb-c::*code-coverage-info*)) :restore-error)
    (check (eq :escaped (catch 'escape
                         (http-coverage-normalization:call-with-projection
                          http-coverage-normalization:*proofs*
                          (lambda (removed) (declare (ignore removed)) (throw 'escape :escaped)))))
           :nonlocal-exit)
    (check (eq original (car sb-c::*code-coverage-info*)) :restore-throw)
    ;; Synthetic control is detached from the real compiler table.
    (let* ((paths (sb-c::covered-file-paths (gethash key original)))
           (copy (sb-c::make-coverage-instrumented-file (copy-seq paths) nil nil))
           (table (make-hash-table :test 'equal))
           (candidate (first (http-coverage-normalization:source-proof-candidates proof)))
           (index (position (first candidate) paths :test #'equal)))
      (replace (sb-c::covered-file-executed copy) (sb-c::covered-file-executed (gethash key original)))
      (setf (sbit (sb-c::covered-file-executed copy) index) 1
            (gethash key table) copy)
      (multiple-value-bind (projection removed)
          (http-coverage-normalization:project-table table http-coverage-normalization:*proofs*)
        (check (= removed 6) :executed-declaration-not-removed)
        (check (= 1 (sbit (sb-c::covered-file-executed (gethash key projection))
                         (position (first candidate) (sb-c::covered-file-paths (gethash key projection))
                                   :test #'equal))) :bit-one-retained)))
    (group :html-native-save-positive)
    (let* ((clean (fixture directory "positive"
                          '((defun clean-key (&key (value 7))
                              (if (plusp value) (list :positive value) (list :negative value))))))
           (clean-proof (compile-fixture clean))
           (proofs (make-hash-table :test 'equal))
           (raw (car sb-c::*code-coverage-info*)))
      (setf (gethash (namestring (truename clean)) proofs) clean-proof)
      (check (equal (clean-key) '(:positive 7)) :clean-default)
      (check (equal (clean-key :value -1) '(:negative -1)) :clean-explicit)
      (http-coverage-normalization:call-with-deferred-projection
       proofs
       (lambda (install)
         (check (eq raw (car sb-c::*code-coverage-info*)) :deferred-not-early)
         (check (= (funcall install) 1) :clean-one-declaration)
         (check (= (funcall install) 1) :idempotent-install)
         (let ((after (counts clean)))
           (check (= (first after) (second after)) :native-expressions-complete)
           (check (= (third after) (fourth after)) :native-branches-complete)
           (format t "COUNTS positive projected=~S~%" after))
         (report (merge-pathnames "positive/" directory) clean)
         (check (zerop (auditor-exit root (merge-pathnames "positive/" directory))) :html-complete)
         (let ((saved (sb-cover:save-coverage))
               (saved-pathname (merge-pathnames "positive.coverage" directory)))
           (sb-cover:save-coverage-in-file saved-pathname)
           (check (plusp (with-open-file (stream saved-pathname :element-type '(unsigned-byte 8))
                          (file-length stream))) :save-file-nonempty)
           (with-open-file (stream saved-pathname)
             (with-standard-io-syntax
               (let ((*read-eval* nil))
                 (check (equalp (read stream) saved) :save-file-exact-data)
                 (check (eq :eof (read stream nil :eof)) :save-file-no-trailing-form))))
           (manifest saved-pathname)
           (dolist (entry saved)
             (let ((file (gethash (first entry) (car sb-c::*code-coverage-info*))))
               (check (equalp (second entry) (sb-c::covered-file-paths file)) :saved-paths)
               (check (equalp (cddr entry) (sb-c::covered-file-executed file)) :saved-bits))))))
      (check (eq raw (car sb-c::*code-coverage-info*)) :deferred-restore))))
  (loop for pathname in sources for before in hashes
        do (check (equalp before (sb-md5:md5sum-file pathname)) :runtime-source-unchanged)
           (manifest pathname))
  (format t "EXISTING selected=~D assertions=~D~%" *groups* *assertions*)
  (unless (or identity-only
              (and ci-mode (not (http-coverage-normalization::normalization-supported-p))))
    (callback-key-controls root directory)
    (placement-key-controls root directory))
  (format t "RESULT selected=~D assertions=~D~%" *groups* *assertions*))
