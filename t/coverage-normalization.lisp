(require :asdf)
(require :sb-cover)
(require :sb-md5)
(let* ((pathname (merge-pathnames "../scripts/coverage-normalization.lisp" *load-truename*))
       (before (sb-md5:md5sum-file pathname)))
  (format t "LOAD-BEFORE ~A md5=~(~{~2,'0X~}~)~%" pathname (coerce before 'list))
  (load pathname)
  (unless (equalp before (sb-md5:md5sum-file pathname))
    (error "Normalizer changed while loading."))
  (format t "LOAD-AFTER ~A md5=~(~{~2,'0X~}~)~%" pathname
          (coerce (sb-md5:md5sum-file pathname) 'list)))

(defpackage #:http-coverage-normalization-tests (:use #:cl))
(in-package #:http-coverage-normalization-tests)

(defvar *assertions* 0)
(defvar *groups* 0)
(defvar *code-roots* nil)
(defvar *initializer-calls* 0)
(defconstant +fixture-seven+ 7)
(defconstant +reader-case+ 29)

(defun check (value label)
  (incf *assertions*)
  (unless value (error "Assertion failed: ~A" label)))

(defun rejects (function label)
  (check (handler-case (progn (funcall function) nil)
           (error (condition) condition))
         label))

(defun group (name)
  (incf *groups*)
  (format t "GROUP ~A~%" name))

(defun with-unsupported-platform (function)
  (let* ((name 'http-coverage-normalization::normalization-supported-p)
         (original (symbol-function name)))
    (unwind-protect
         (progn (setf (symbol-function name) (constantly nil))
                (funcall function))
      (setf (symbol-function name) original))))

(defun manifest (pathname)
  (format t "SOURCE ~A md5=~(~{~2,'0X~}~)~%"
          pathname (coerce (sb-md5:md5sum-file pathname) 'list)))

(defun identity-controls ()
  (group :deferred-table-identity)
  (let ((original (car sb-c::*code-coverage-info*))
        (platform-function (symbol-function 'http-coverage-normalization::normalization-supported-p))
        (proofs (make-hash-table :test 'equal))
        (observations nil))
    (dolist (policy '(:native :unsupported))
      (funcall
       (if (eq policy :unsupported) #'with-unsupported-platform #'funcall)
       (lambda ()
         (dotimes (stage 3)
           (let ((rejected nil))
             (handler-case
                 (http-coverage-normalization:call-with-deferred-projection
                  proofs
                  (lambda (install)
                    (dotimes (attempt stage)
                      (check (zerop (funcall install)) :empty-proof-zero-removal))
                    ;; Equal contents must not authorize a different global table.
                    (let ((replacement (make-hash-table :test (hash-table-test original))))
                      (maphash (lambda (key value) (setf (gethash key replacement) value)) original)
                      (setf (car sb-c::*code-coverage-info*) replacement))
                    (funcall install)))
               (simple-error (condition)
                 (setf rejected (not (null (search "Coverage table changed"
                                                  (princ-to-string condition)))))))
             (let ((restored (eq original (car sb-c::*code-coverage-info*))))
               (format t "IDENTITY policy=~S installs-before-replacement=~D rejected=~S restored=~S~%"
                       policy stage rejected restored)
               (push (list rejected restored) observations))))
         (rejects (lambda ()
                    (http-coverage-normalization:call-with-deferred-projection
                     proofs (lambda (install) (funcall install) (error "Consumer failed."))))
                  :deferred-consumer-error)
         (check (eq original (car sb-c::*code-coverage-info*)) :deferred-error-restore)
         (check (eq :escaped
                    (catch 'escape
                      (http-coverage-normalization:call-with-deferred-projection
                       proofs (lambda (install) (funcall install) (throw 'escape :escaped)))))
                :deferred-consumer-throw)
         (check (eq original (car sb-c::*code-coverage-info*)) :deferred-throw-restore))))
    ;; Collect every observation before asserting, including with the old implementation.
    (dolist (observation (nreverse observations))
      (check (first observation) :replacement-rejected-on-every-install)
      (check (second observation) :replacement-original-restored))
    (check (eq platform-function
               (symbol-function 'http-coverage-normalization::normalization-supported-p))
           :identity-platform-function-restored)))

(defun fixture (directory name forms)
  (let ((pathname (merge-pathnames (make-pathname :name name :type "lisp") directory)))
    (with-open-file (stream pathname :direction :output :if-exists :error
                           :external-format :utf-8)
      (with-standard-io-syntax
        (write '(in-package #:http-coverage-normalization-tests) :stream stream)
        (terpri stream)
        (dolist (form forms) (write form :stream stream) (terpri stream))))
    (manifest pathname)
    pathname))

(defun retain-coverage-code ()
  ;; SBCL records instrumented code in weak vectors; the vectors do not keep it alive.
  (setf *code-roots*
        (loop for vector in (cdr sb-c::*code-coverage-info*) nconc
              (loop for index below (sb-int:weak-vector-len vector)
                    for code = (sb-int:weak-vector-ref vector index)
                    when code collect code))))

(defun compile-fixture (pathname)
  (let ((proof (http-coverage-normalization:capture-source pathname)))
    (check proof :supported-source)
    (sb-sys:without-gcing
      (proclaim '(optimize (sb-cover:store-coverage-data 3)))
      (multiple-value-bind (fasl warnings failure)
          (compile-file pathname :output-file (make-pathname :type "fasl" :defaults pathname)
                        :verbose nil :print nil :external-format :utf-8 :block-compile nil)
        (check (and fasl (not warnings) (not failure)) :clean-compile)
        (load fasl :verbose nil :print nil))
      (retain-coverage-code)
      (proclaim '(optimize (sb-cover:store-coverage-data 0)))
      (http-coverage-normalization:seal-source pathname proof))
    proof))

(defun counts (pathname)
  (let ((info (sb-cover::compute-file-info (namestring (truename pathname)) :default)))
    (list (sb-cover::all-of (getf info :expression))
          (sb-cover::ok-of (getf info :expression))
          (sb-cover::all-of (getf info :branch))
          (sb-cover::ok-of (getf info :branch)))))

(defun compare-projection (original projection proof)
  (let* ((paths (sb-c::covered-file-paths original))
         (new-paths (sb-c::covered-file-paths projection))
         (bits (sb-c::covered-file-executed original))
         (new-bits (sb-c::covered-file-executed projection)))
    (dotimes (index (length paths))
      (let* ((path (aref paths index))
             (new (position path new-paths :test #'equal)))
        (if new
            (check (= (sbit bits index) (sbit new-bits new)) :retained-bit)
            (progn
              (check (zerop (sbit bits index)) :only-zero-removed)
              (check (member path (mapcar #'first
                        (http-coverage-normalization:source-proof-candidates proof))
                             :test #'equal) :only-semantic-key-removed)))))
    (check (= (length new-paths) (length new-bits)) :aligned-record)))

(defun report (directory pathname)
  (sb-cover:report directory :form-mode :whole
                  :if-matches (lambda (name) (equal (truename name) (truename pathname)))))

(defun auditor-exit (root directory)
  (nth-value 2 (uiop:run-program (list "perl" (namestring (merge-pathnames "scripts/check-coverage.pl" root))
                                     (namestring directory))
                               :ignore-error-status t :output :string :error-output :string)))

(defun literal-and-supplied-controls (root directory)
  (group :literal-and-supplied-native-proof)
  (let* ((http-coverage-normalization:*proofs* (make-hash-table :test 'equal))
         (specs '((string-proof "message" nil) (empty-proof "" nil)
                  (supplied-nil-proof nil t) (supplied-integer-proof 7 t)
                  (supplied-boolean-proof t t) (supplied-keyword-proof :ok t)
                  (supplied-string-proof "message" t) (supplied-empty-proof "" t)))
         (forms (append
                 (loop for (name value supplied) in specs
                       collect `(defun ,name (&key (value ,value ,@(when supplied '(supplied))))
                                  (list value ,(if supplied 'supplied nil))))
                 '((defun evaluated-string-proof (&key (value (progn (incf *initializer-calls*) "dynamic")))
                     (list value nil))
                   (defun foldable-string-proof (&key (value (concatenate 'string "a" "b")))
                     (list value nil))
                   (defun optional-string-proof (&optional (value "optional")) (list value nil))
                   (defun aliased-string-proof (&key ((:other value) "aliased")) (list value nil))
                   (defun ordinary-string-proof () "message")
                   (defun lookalike-string-proof () (let ((value "message")) (list value nil))))
                 '((defun string-branch-proof (flag)
                     (if flag (list :yes flag) (list :no flag))))))
         (pathname (fixture directory "literal-supplied-controls" forms))
         (proof (compile-fixture pathname))
         (key (namestring (truename pathname)))
         (original (car sb-c::*code-coverage-info*))
         (file (gethash key original))
         (paths (sb-c::covered-file-paths file))
         (expected (loop for top from 1 to 8 collect (list 1 2 top)))
         (snapshots nil)
         (source-forms
           (with-open-file (stream pathname :external-format :utf-8)
             (with-standard-io-syntax
               (let ((*read-eval* nil))
                 (loop for form = (read stream nil :eof) until (eq form :eof)
                       collect form))))))
    (setf *initializer-calls* 0)
    (labels ((snapshot (stage)
               (sb-cover::refresh-coverage-bits)
               (let ((bits (sb-c::covered-file-executed file)))
                 (dolist (path expected)
                   (check (= 1 (count path paths :test #'equal)) :unique-atomic-native-path)
                   (let ((bit (sbit bits (position path paths :test #'equal))))
                     (format t "ATOMIC stage=~S path=~S bit=~D~%" stage path bit)
                     (check (zerop bit) :static-atomic-native-bit)))
                 (loop for top from 1 to 8
                       for path = (list 3 top)
                       do (check (= 1 (count path paths :test #'equal)) :unique-body-native-path)
                          (let ((bit (sbit bits (position path paths :test #'equal))))
                            (format t "BODY stage=~S path=~S bit=~D~%" stage path bit)
                            (check (= bit (if (eq stage :baseline) 0 1)) :body-native-bit)))
                 (push (copy-seq bits) snapshots)))
             (invoke (explicit)
               (dolist (spec specs)
                 (destructuring-bind (name value supplied) spec
                   (check (equal (apply name (when explicit '(:value :explicit)))
                                 (list (if explicit :explicit value) (and supplied explicit)))
                          :atomic-default-and-supplied-value)))))
      (snapshot :baseline)
      (invoke t)
      (check (equal (funcall 'evaluated-string-proof :value :explicit) '(:explicit nil))
             :explicit-dynamic-string)
      (check (zerop *initializer-calls*) :dynamic-string-not-evaluated)
      (check (equal (funcall 'string-branch-proof t) '(:yes t)) :true-if-body)
      (snapshot :explicit)
      (invoke nil)
      (check (equal (funcall 'evaluated-string-proof) '("dynamic" nil)) :omitted-dynamic-string)
      (check (= *initializer-calls* 1) :dynamic-string-evaluated-once)
      (check (equal (funcall 'string-branch-proof nil) '(:no nil)) :false-if-body)
      (snapshot :omitted))
    (loop for path in expected for form in forms
          do (check (equal (second (third form))
                           (reduce (lambda (node index) (nth index node))
                                   (reverse path) :initial-value source-forms))
                    :native-path-source-binding))
    (dolist (entry '(((1 1 2 9) (0 0 1)) ((1 1 1 2 9) (0 0 1))
                     ((2 1 1 2 9) (0 0 1))
                     ((2 3 15) (0 1 1)) ((3 3 15) (0 0 1))))
      (destructuring-bind (path expected-bits) entry
        (check (= 1 (count path paths :test #'equal)) :unique-runtime-control-path)
        (let* ((index (position path paths :test #'equal))
               (bits (mapcar (lambda (snapshot) (sbit snapshot index)) (reverse snapshots))))
          (check (equal bits expected-bits) :runtime-control-flips)
          (format t "CONTROL path=~S bits=~S calls=~D~%" path bits *initializer-calls*))))
    (report (merge-pathnames "literal-native/" directory) pathname)
    (check (not (zerop (auditor-exit root (merge-pathnames "literal-native/" directory))))
           :raw-literal-html-gap)
    (format t "NATIVE-PROOF assertions=~D~%" *assertions*)
    ;; Native evidence is collected before requiring the expanded matcher.
    (group :literal-and-supplied-projection)
    (check (equal (mapcar #'first (http-coverage-normalization:source-proof-candidates proof))
                  expected) :only-eight-proven-bindings)
    (dolist (candidate (http-coverage-normalization:source-proof-candidates proof))
      (when (stringp (second candidate))
        (check (not (eq (second candidate) (third candidate))) :independent-string-snapshot)
        (check (equal (second candidate) (third candidate)) :exact-string-snapshot)))
    (sb-cover::refresh-coverage-bits)
    (let ((before (counts pathname)))
      (http-coverage-normalization:call-with-projection
       http-coverage-normalization:*proofs*
       (lambda (removed)
         (check (= removed 8) :exact-eight-literal-and-supplied-removal)
         (compare-projection file (gethash key (car sb-c::*code-coverage-info*)) proof)
         (check (equal (counts pathname) (cons (- (first before) 8) (rest before)))
                :literal-total-only)
         (format t "COUNTS literal raw=~S projected=~S removed=~D~%" before (counts pathname) removed)
         (report (merge-pathnames "literal-negative/" directory) pathname)
         (check (not (zerop (auditor-exit root (merge-pathnames "literal-negative/" directory))))
                :literal-html-retains-genuine-gaps))))
    (check (eq original (car sb-c::*code-coverage-info*)) :literal-projection-restore)
    (group :string-proof-mutation-fail-closed)
    (let* ((candidate (find-if (lambda (item) (and (stringp (second item))
                                                  (plusp (length (second item)))))
                              (http-coverage-normalization:source-proof-candidates proof)))
           (initializer (second candidate))
           (snapshot (third candidate))
           (initial-character (char initializer 0)))
      ;; Mutate only fresh proof objects, never compiled fixture string literals.
      (unwind-protect
           (progn
             (setf (char initializer 0) #\X)
             (rejects (lambda () (http-coverage-normalization:project-table
                                 original http-coverage-normalization:*proofs*))
                      :initializer-string-mutation)
             (setf (char initializer 0) initial-character
                   (char snapshot 0) #\X)
             (rejects (lambda () (http-coverage-normalization:project-table
                                 original http-coverage-normalization:*proofs*))
                      :snapshot-string-mutation)
             (setf (char initializer 0) #\X)
             (rejects (lambda () (http-coverage-normalization:project-table
                                 original http-coverage-normalization:*proofs*))
                      :matching-string-mutation-rejected-by-source-bytes))
        (setf (char initializer 0) initial-character
              (char snapshot 0) initial-character)))
    (http-coverage-normalization:call-with-projection
     http-coverage-normalization:*proofs*
     (lambda (removed) (check (= removed 8) :restored-string-proof-valid)))
    (check (eq original (car sb-c::*code-coverage-info*)) :string-failure-original-restore)
    (group :literal-and-supplied-html-save-positive)
    (let* ((clean (fixture directory "literal-supplied-positive" (subseq forms 0 8)))
           (clean-proof (compile-fixture clean))
           (proofs (make-hash-table :test 'equal))
           (raw (car sb-c::*code-coverage-info*)))
      (setf (gethash (namestring (truename clean)) proofs) clean-proof)
      (dolist (spec specs)
        (destructuring-bind (name value supplied) spec
          (check (equal (funcall name) (list value nil)) :clean-atomic-omitted)
          (check (equal (funcall name :value :explicit) (list :explicit supplied))
                 :clean-atomic-explicit)))
      (sb-ext:gc :full t)
      (sb-cover::refresh-coverage-bits)
      (let ((before (counts clean)))
        (http-coverage-normalization:call-with-deferred-projection
         proofs
         (lambda (install)
           (check (= (funcall install) 8) :clean-eight-declarations)
           (check (= (funcall install) 8) :clean-eight-idempotent)
           (let ((after (counts clean)))
             (check (equal after (cons (- (first before) 8) (rest before))) :clean-atomic-total-only)
             (check (= (first after) (second after)) :clean-atomic-native-complete)
             (format t "COUNTS literal-positive raw=~S projected=~S removed=8~%" before after))
           (report (merge-pathnames "literal-positive/" directory) clean)
           (check (zerop (auditor-exit root (merge-pathnames "literal-positive/" directory)))
                  :clean-atomic-html-complete)
           (let* ((saved (sb-cover:save-coverage))
                  (entry (assoc (namestring (truename clean)) saved :test #'equal))
                  (saved-pathname (merge-pathnames "literal-positive.coverage" directory))
                  (projected (gethash (namestring (truename clean)) (car sb-c::*code-coverage-info*))))
             (check entry :clean-atomic-save-entry)
             (check (equalp (second entry) (sb-c::covered-file-paths projected)) :clean-atomic-save-paths)
             (check (equalp (cddr entry) (sb-c::covered-file-executed projected)) :clean-atomic-save-bits)
             (sb-cover:save-coverage-in-file saved-pathname)
             (with-open-file (stream saved-pathname)
               (with-standard-io-syntax
                 (let ((*read-eval* nil))
                   (check (equalp (read stream) saved) :clean-atomic-save-bytes)
                   (check (eq :eof (read stream nil :eof)) :clean-atomic-save-eof))))
             (manifest saved-pathname)))))
      (check (eq raw (car sb-c::*code-coverage-info*)) :clean-atomic-final-restore))))

(defun float-and-returned-lambda-controls (root directory)
  (group :float-and-returned-lambda-native-proof)
  (let* ((http-coverage-normalization:*proofs* (make-hash-table :test 'equal))
         (forms '((defun single-float-proof (&key (value 0.25)) (list value))
                  (defun double-float-proof (&key (value 0.25d0)) (list value))
                  (defun returned-nil-proof ()
                    (lambda (flag &key (value nil supplied))
                      (if flag (list :yes value supplied) (list :no value supplied))))
                  (defun compound-float-proof
                      (&key (value (progn (incf *initializer-calls*) 0.25)))
                    (list value))
                  (defun dynamic-float-proof (&key (value *initializer-calls*)) (list value))
                  (defun quoted-lambda-proof () '(lambda (&key (value nil)) (list value)))
                  (defun funcalled-lambda-proof ()
                    (funcall (lambda (&key (value nil)) (list value))))
                  (defstruct float-structure-proof (value 0.25))
                  (defun float-lambda-branch-proof (flag)
                    (if flag (list :yes flag) (list :no flag)))))
         (pathname (fixture directory "float-returned-lambda" forms))
         (proof (compile-fixture pathname))
         (key (namestring (truename pathname)))
         (original (car sb-c::*code-coverage-info*))
         (file (gethash key original))
         (paths (sb-c::covered-file-paths file))
         (expected '((1 2 1) (1 2 2) (2 1 3 3)))
         (snapshots nil)
         (closure (funcall 'returned-nil-proof))
         (source-forms
           (with-open-file (stream pathname :external-format :utf-8)
             (with-standard-io-syntax
               (let ((*read-eval* nil))
                 (loop for form = (read stream nil :eof) until (eq form :eof)
                       collect form))))))
    (check (equal (mapcar #'first (http-coverage-normalization:source-proof-candidates proof))
                  expected) :only-literal-floats-and-direct-lambda)
    (loop for path in expected
          for binding in '((value 0.25) (value 0.25d0) (value nil supplied))
          do (check (equal binding (reduce (lambda (node index) (nth index node))
                                           (reverse path) :initial-value source-forms))
                    :float-lambda-native-source-binding))
    (labels ((snapshot (stage)
               (sb-cover::refresh-coverage-bits)
               (let ((bits (sb-c::covered-file-executed file)))
                 (dolist (path expected)
                   (check (= 1 (count path paths :test #'equal)) :unique-float-lambda-path)
                   (let ((bit (sbit bits (position path paths :test #'equal))))
                     (format t "FLOAT-LAMBDA stage=~S path=~S bit=~D~%" stage path bit)
                     (check (zerop bit) :float-lambda-default-remains-native-zero)))
                 (push (copy-seq bits) snapshots))))
      (setf *initializer-calls* 0)
      (snapshot :baseline)
      (let ((single (first (funcall 'single-float-proof :value 0.5)))
            (double (first (funcall 'double-float-proof :value 0.5d0))))
        (check (eql single 0.5) :explicit-single-value)
        (check (typep single 'single-float) :explicit-single-type)
        (check (eql double 0.5d0) :explicit-double-value)
        (check (typep double 'double-float) :explicit-double-type))
      (check (equal (funcall closure t :value nil) '(:yes nil t)) :lambda-explicit-supplied-true)
      (check (equal (funcall 'compound-float-proof :value :explicit) '(:explicit))
             :compound-explicit-value)
      (check (zerop *initializer-calls*) :compound-explicit-no-side-effect)
      (check (equal (funcall 'float-lambda-branch-proof t) '(:yes t))
             :genuine-branch-normal-control)
      (snapshot :explicit)
      (let ((single (first (funcall 'single-float-proof)))
            (double (first (funcall 'double-float-proof))))
        (check (eql single 0.25) :omitted-single-value)
        (check (typep single 'single-float) :omitted-single-type)
        (check (eql double 0.25d0) :omitted-double-value)
        (check (typep double 'double-float) :omitted-double-type))
      (check (equal (funcall closure nil) '(:no nil nil)) :lambda-omitted-supplied-false)
      (check (equal (funcall 'compound-float-proof) '(0.25)) :compound-omitted-value)
      (check (= *initializer-calls* 1) :compound-side-effect-once)
      (let ((*initializer-calls* 23))
        (check (equal (funcall 'dynamic-float-proof) '(23)) :dynamic-default-runtime-value))
      (check (equal (funcall 'quoted-lambda-proof) '(lambda (&key (value nil)) (list value)))
             :quoted-lambda-is-data)
      (check (equal (funcall 'funcalled-lambda-proof) '(nil)) :funcalled-lambda-runtime-value)
      (snapshot :omitted))
    (dolist (entry '(((1 1 2 4) (0 0 1)) ((1 1 1 2 4) (0 0 1))
                     ((2 1 1 2 4) (0 0 1))
                     ((2 2 3 3) (0 1 1)) ((3 2 3 3) (0 0 1))
                     ((2 3 9) (0 1 1)) ((3 3 9) (0 0 0))))
      (destructuring-bind (path expected-bits) entry
        (check (= 1 (count path paths :test #'equal)) :unique-float-lambda-control-path)
        (let ((bits (mapcar (lambda (snapshot)
                             (sbit snapshot (position path paths :test #'equal)))
                           (reverse snapshots))))
          (format t "FLOAT-LAMBDA-CONTROL path=~S bits=~S~%" path bits)
          (check (equal bits expected-bits) :genuine-control-native-transitions))))
    (report (merge-pathnames "float-lambda-native/" directory) pathname)
    (check (not (zerop (auditor-exit root (merge-pathnames "float-lambda-native/" directory))))
           :float-lambda-native-html-incomplete)
    (group :float-lambda-projection-nonmutation)
    (let ((saved-paths (map 'vector #'copy-tree paths))
          (saved-bits (copy-seq (sb-c::covered-file-executed file)))
          (saved-locations (copy-tree (coerce (sb-c::covered-file-locations file) 'list)))
          (before (counts pathname)))
      (http-coverage-normalization:call-with-projection
       http-coverage-normalization:*proofs*
       (lambda (removed)
         (check (= removed 3) :exact-three-float-lambda-removal)
         (compare-projection file (gethash key (car sb-c::*code-coverage-info*)) proof)
         (check (equal (counts pathname) (cons (- (first before) 3) (rest before)))
                :float-lambda-expression-total-only)
         (report (merge-pathnames "float-lambda-negative/" directory) pathname)
         (check (not (zerop (auditor-exit root (merge-pathnames "float-lambda-negative/" directory))))
                :float-lambda-genuine-gaps-retained)))
      (check (eq original (car sb-c::*code-coverage-info*)) :float-lambda-normal-table-restore)
      (check (eq file (gethash key original)) :float-lambda-original-record-identity)
      (check (equalp saved-paths paths) :float-lambda-original-paths-unchanged)
      (check (equalp saved-bits (sb-c::covered-file-executed file)) :float-lambda-original-bits-unchanged)
      (check (equalp saved-locations (coerce (sb-c::covered-file-locations file) 'list))
             :float-lambda-original-locations-unchanged)
      ;; A detached record tests the zero-only rule without mutating native counters.
      (let* ((detached (sb-c::make-coverage-instrumented-file
                        (map 'vector #'copy-tree paths)
                        (copy-seq (sb-c::covered-file-locations file))
                        (copy-seq (sb-c::covered-file-lines file))))
             (bits (sb-c::covered-file-executed detached))
             (index (position (first expected) paths :test #'equal)))
        (replace bits saved-bits)
        (setf (sbit bits index) 1)
        (multiple-value-bind (projected removed)
            (http-coverage-normalization::project-file pathname detached proof)
          (check (= removed 2) :observed-float-default-not-removed)
          (let ((retained (position (first expected) (sb-c::covered-file-paths projected) :test #'equal)))
            (check retained :observed-float-path-retained)
            (check (= 1 (sbit (sb-c::covered-file-executed projected) retained))
                   :observed-float-bit-retained))
          (check (= 1 (sbit bits index)) :detached-input-bit-unchanged)
          (check (equalp saved-bits (sb-c::covered-file-executed file)) :native-counters-not-mutated))))
    (group :float-type-proof-fail-closed)
    (dolist (candidate (subseq (http-coverage-normalization:source-proof-candidates proof) 0 2))
      (let* ((initializer (second candidate)) (value (third candidate))
             (changed (float initializer (if (typep initializer 'single-float) 1.0d0 1.0))))
        (check (= initializer changed) :tamper-preserves-numeric-value)
        (check (not (eql initializer changed)) :tamper-changes-float-type)
        (unwind-protect
             (progn
               (setf (third candidate) changed)
               (rejects (lambda () (http-coverage-normalization:project-table
                                   original http-coverage-normalization:*proofs*))
                        :float-snapshot-type-change-rejected)
               (setf (third candidate) value (second candidate) changed)
               (rejects (lambda () (http-coverage-normalization:project-table
                                   original http-coverage-normalization:*proofs*))
                        :float-initializer-type-change-rejected)
               (setf (third candidate) changed)
               (rejects (lambda () (http-coverage-normalization:project-table
                                   original http-coverage-normalization:*proofs*))
                        :matching-float-type-change-rejected-by-source))
          (setf (second candidate) initializer (third candidate) value))))
    (http-coverage-normalization:call-with-projection
     http-coverage-normalization:*proofs*
     (lambda (removed) (check (= removed 3) :restored-float-proof-valid)))
    (rejects (lambda ()
               (http-coverage-normalization:call-with-projection
                http-coverage-normalization:*proofs*
                (lambda (removed) (check (= removed 3) :error-consumer-projection)
                  (error "Float projection consumer failed."))))
             :float-lambda-consumer-error)
    (check (eq original (car sb-c::*code-coverage-info*)) :float-lambda-error-table-restore)
    (check (eq :escaped
               (catch 'float-escape
                 (http-coverage-normalization:call-with-projection
                  http-coverage-normalization:*proofs*
                  (lambda (removed) (check (= removed 3) :throw-consumer-projection)
                    (throw 'float-escape :escaped)))))
           :float-lambda-consumer-throw)
    (check (eq original (car sb-c::*code-coverage-info*)) :float-lambda-throw-table-restore)))

