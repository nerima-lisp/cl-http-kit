+    #[test]
+    fn digit_char_p_checks_the_character_not_the_radix() {
+        for (input, expected) in [
+            ("(digit-char-p #\\A)", 0),
+            ("(digit-char-p #\\A 16)", 0),
+            ("(DIGIT-CHAR-P #\\A 16)", 0),
+            ("(digit-char-p 16 10)", 1),
+            ("(digit-char-p \"A\" 16)", 1),
+            ("(char= #\\A 16)", 1),
+        ] {
+            let tree = SyntaxTree::parse_with_dialect(input, Dialect::CommonLisp)
+                .expect("parse character call");
+            let view = tree.select_path(&SexprPath::root_child(0)).expect("select call").view();
+            let mut count = 0;
+            let mut violations = Vec::new();
+            examine_call(
+                &view,
+                &|child| atom_text(child).is_some_and(|text| text.parse::<u32>().is_ok()),
+                &mut count,
+                &mut violations,
+            );
+            assert_eq!(count, 1, "{input}");
+            assert_eq!(violations.len(), expected, "{input}");
+        }
+    }
+
+    #[test]
+    fn digit_char_p_still_rejects_a_string_character() {
