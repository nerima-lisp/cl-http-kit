(in-package #:http-kit)

(defun http-response-summary (response)
  (with-output-to-string (stream)
    (write-string (http-response-protocol-version response) stream)
    (write-char #\Space stream)
    (write (http-response-status response) :stream stream :escape nil)
    (write-char #\Space stream)
    (write-string (http-response-reason response) stream)
    (write-string " headers=" stream)
    (write (length (http-response-headers response)) :stream stream :escape nil)
    (write-string " trailers=" stream)
    (write (length (http-response-trailers response)) :stream stream :escape nil)
    (write-string " body-bytes=" stream)
    (write (length (http-response-body response)) :stream stream :escape nil)))
